{
  "name": "@mindthegap/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=../.env src/scripts/migrate.ts",
    "db:ingest": "node --env-file-if-exists=../.env src/scripts/ingest.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
