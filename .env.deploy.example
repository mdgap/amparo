# Variáveis do docker-compose.yml — no Dokploy, cole na aba Environment.
# Não versione o arquivo preenchido.

# Banco (o Postgres sobe no próprio compose)
POSTGRES_USER=mindthegap
POSTGRES_PASSWORD=
POSTGRES_DB=mindthegap

# OpenRouter: uma chave para redação, classificação e embeddings.
# Sem ela a aplicação sobe: só o motor de regras e busca lexical.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
EMBEDDINGS_MODEL=voyageai/voyage-4-lite
EMBEDDINGS_DIM=1024
