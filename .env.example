# ---- Banco ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindthegap

# ---- LLM (redação e classificacao; NUNCA calcula numero) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Embeddings (pgvector) ----
# provider: voyage | none  (none = busca lexical, roda sem chave)
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
EMBEDDINGS_DIM=1024

# ---- API ----
PORT=3333
CORS_ORIGIN=http://localhost:5173
