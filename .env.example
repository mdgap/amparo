# ---- Banco ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindthegap

# ---- OpenRouter: UMA chave para redação, classificação e embeddings ----
# Sem ela o app sobe igual: só o motor de regras + busca lexical.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Redação e classificação. NUNCA calcula número.
OPENROUTER_MODEL=openai/gpt-oss-120b

# Embeddings. "none" força a busca lexical mesmo com chave.
# EMBEDDINGS_DIM precisa bater com VECTOR(n) da migração 001.
EMBEDDINGS_MODEL=voyageai/voyage-4-lite
EMBEDDINGS_DIM=1024

# ---- API ----
PORT=3333
CORS_ORIGIN=http://localhost:5173
